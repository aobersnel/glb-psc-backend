# Local .terraform directories and lock files
**/.terraform/
**/.terraform/*
**/.terraform.lock.hcl
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars and input variable value files
*.tfvars
*.tfvars.json
*.tfvars.*

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
